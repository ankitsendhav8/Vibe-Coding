# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# MSSQL Database
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
